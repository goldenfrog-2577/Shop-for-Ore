		"events": {
			"minecraft:clear_add_raid_omen": {
				"add": {
					"component_groups": [
						"minecraft:clear_raid_omen_spell_effect"
					]
				},
				"remove": {
					"component_groups": [
						"minecraft:add_raid_omen"
					]
				}
			},
			"minecraft:remove_raid_trigger": {
				"remove": {
					"component_groups": [
						"minecraft:raid_trigger"
					]
				}
			},
			"minecraft:gain_raid_omen": {
				"add": {
					"component_groups": [
						"minecraft:add_raid_omen"
					]
				}
			},
			"minecraft:trigger_raid": {
				"add": {
					"component_groups": [
						"minecraft:raid_trigger"
					]
				}
			},
			"server:kick": {
				"queue_command": {
					"command": [
						"tellraw @a {\"rawtext\":[{\"translate\":\"chat.server.kicked\",\"with\":{\"rawtext\":[{\"selector\":\"@s\"}]}}]}",
						"tag @s add state:kick"
					]
				}
			},
			"server:kick_simple": {
				"add": {
					"component_groups": [
						"server:kick_simple"
					]
				}
			},
			"server:hunger_on": {
				"remove": {
					"component_groups": [
						"server:hunger_off"
					]
				},
				"add": {
					"component_groups": [
						"server:hunger_normal"
					]
				}
			},
			"server:hunger_off": {
				"remove": {
					"component_groups": [
						"server:hunger_normal"
					]
				},
				"add": {
					"component_groups": [
						"server:hunger_off"
					]
				}
			}
		}
