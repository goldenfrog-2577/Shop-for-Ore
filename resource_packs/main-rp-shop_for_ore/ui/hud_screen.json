{
	"namespace": "hud",

	// Только изменения поверх ванильного HUD (игра сливает этот файл с ванильным hud_screen.json).
	// Раньше здесь лежала полная копия старого ванильного HUD — на 1.19.5x она давала
	// «JSON UI parse failure - expected a string» (слоты хотбара) и «Unknown property [orientation]».

	// Текст actionbar — слева по центру экрана, выше прицела
	"hud_actionbar_text": {
		"anchor_from": "left_middle",
		"anchor_to": "left_middle",
		"offset": [0, "50%-168px"],
		"controls": [{
			"actionbar_message": {
				"type": "label",
				"anchor_from": "right_middle",
				"anchor_to": "right_middle",
				"color": "$tool_tip_text",
				"layer": 31,
				"text": "$actionbar_text",
				"localize": false,
				"alpha": "@hud.anim_actionbar_text_alpha_out"
			}
		}]
	}
}